# Use slim Python base image
FROM python:3.9-slim

# Set working directory
WORKDIR /app

# Copy requirements (if you have one) and install
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt || true

# Copy all app files
COPY . .

# Run Python in unbuffered mode so logs flush immediately
CMD ["python", "-u", "app.py"]
